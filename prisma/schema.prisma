generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum ContractFormat {
  OPENAPI
  GRAPHQL
  OTHER
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum CheckStatus {
  SUCCESS
  FAILURE
  TIMEOUT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ChangeType {
  ENDPOINT_REMOVED
  METHOD_REMOVED
  REQUIRED_PARAM_ADDED
  PARAM_REMOVED
  PARAM_TYPE_CHANGED
  RESPONSE_SCHEMA_CHANGED
  OTHER
}

// ---------- Models ----------

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  apiServices ApiService[]
  consumers   Consumer[]
}

model ApiService {
  id               String     @id @default(uuid()) @db.Uuid
  projectId        String     @db.Uuid
  name             String
  baseUrl          String
  description      String?
  healthPath       String     @default("/health")
  httpMethod       HttpMethod @default(GET)
  expectedStatus   Int        @default(200)
  checkIntervalSec Int        @default(60)
  timeoutMs        Int        @default(5000)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contracts    ApiContract[]
  endpoints    Endpoint[]
  dependencies Dependency[]
  checks       ApiCheck[]
  incidents    Incident[]

  @@index([projectId])
}

model Consumer {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependencies Dependency[]

  @@index([projectId])
}

model ApiContract {
  id           String         @id @default(uuid()) @db.Uuid
  apiServiceId String         @db.Uuid
  name         String
  format       ContractFormat @default(OPENAPI)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  apiService ApiService         @relation(fields: [apiServiceId], references: [id], onDelete: Cascade)
  versions   ContractVersion[]

  @@index([apiServiceId])
}

model ContractVersion {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @db.Uuid
  version    String
  definition Json
  checksum   String?
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  contract         ApiContract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changesFrom      BreakingChange[] @relation("ChangeFromVersion")
  changesTo        BreakingChange[] @relation("ChangeToVersion")

  @@unique([contractId, version])
}

model Endpoint {
  id           String     @id @default(uuid()) @db.Uuid
  apiServiceId String     @db.Uuid
  method       HttpMethod
  path         String
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  apiService   ApiService           @relation(fields: [apiServiceId], references: [id], onDelete: Cascade)
  usedBy       DependencyEndpoint[]
  changes      BreakingChange[]

  @@unique([apiServiceId, method, path])
}

model Dependency {
  id           String      @id @default(uuid()) @db.Uuid
  consumerId   String      @db.Uuid
  apiServiceId String      @db.Uuid
  environment  Environment @default(PRODUCTION)
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  consumer   Consumer             @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  apiService ApiService           @relation(fields: [apiServiceId], references: [id], onDelete: Cascade)
  endpoints  DependencyEndpoint[]

  @@unique([consumerId, apiServiceId, environment])
  @@index([apiServiceId])
}

model DependencyEndpoint {
  id           String @id @default(uuid()) @db.Uuid
  dependencyId String @db.Uuid
  endpointId   String @db.Uuid

  dependency Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([dependencyId, endpointId])
  @@index([endpointId])
}

model BreakingChange {
  id            String     @id @default(uuid()) @db.Uuid
  fromVersionId String     @db.Uuid
  toVersionId   String     @db.Uuid
  endpointId    String?    @db.Uuid
  changeType    ChangeType
  severity      Severity   @default(HIGH)
  description   String
  detectedAt    DateTime   @default(now()) @db.Timestamptz(6)

  fromVersion ContractVersion @relation("ChangeFromVersion", fields: [fromVersionId], references: [id], onDelete: Cascade)
  toVersion   ContractVersion @relation("ChangeToVersion", fields: [toVersionId], references: [id], onDelete: Cascade)
  endpoint    Endpoint?       @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([fromVersionId])
  @@index([toVersionId])
  @@index([endpointId])
}

model ApiCheck {
  id             String      @id @default(uuid()) @db.Uuid
  apiServiceId   String      @db.Uuid
  incidentId     String?     @db.Uuid
  environment    Environment @default(PRODUCTION)
  status         CheckStatus
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime    @default(now()) @db.Timestamptz(6)

  apiService ApiService @relation(fields: [apiServiceId], references: [id], onDelete: Cascade)
  incident   Incident?  @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([apiServiceId, checkedAt])
  @@index([incidentId])
}

model Incident {
  id           String         @id @default(uuid()) @db.Uuid
  apiServiceId String         @db.Uuid
  title        String
  description  String?
  severity     Severity       @default(MEDIUM)
  status       IncidentStatus @default(OPEN)
  detectedAt   DateTime       @default(now()) @db.Timestamptz(6)
  resolvedAt   DateTime?      @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  apiService ApiService @relation(fields: [apiServiceId], references: [id], onDelete: Cascade)
  checks     ApiCheck[]

  @@index([apiServiceId])
  @@index([status])
}
